      "parameters": {
        "jsCode": "// n8n task runner sandbox disallows require('crypto').\n// Pure-JS stable hash (FNV-1a 32-bit) to generate a deterministic jobKey.\n\nfunction norm(s) {\n  return (s || '')\n    .toString()\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n}\n\nfunction fnv1a32(str) {\n  let hash = 0x811c9dc5; // offset basis\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    // hash *= 16777619 (with 32-bit overflow)\n    hash = (hash + ((hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24))) >>> 0;\n  }\n  return ('00000000' + hash.toString(16)).slice(-8);\n}\n\nconst job = $json;\nconst companyName = norm(job.company?.name || job.company?.universalName);\nconst title = norm(job.title);\nconst loc = norm(job.location);\nconst url = norm(job.linkedinUrl || job.url);\n\nconst keyRaw = `${companyName}|${title}|${loc}|${url}`;\nconst jobKey = fnv1a32(keyRaw);\n\nreturn [{\n  jobKey,\n  runAt: new Date().toISOString(),\n  title: job.title,\n  company: job.company?.name || job.company?.universalName,\n  companyUniversal: job.company?.universalName,\n  location: job.location,\n  workplaceType: job.workplaceType,\n  employmentType: job.employmentType,\n  postedDate: job.postedDate,\n  url: job.linkedinUrl || job.url,\n  descriptionText: job.descriptionText || '',\n  source: 'apify:linkedin-job-search'\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
